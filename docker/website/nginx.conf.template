upstream monkey_island_app {
    server app:8000;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 444;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    include /etc/nginx/origin/allowlist.conf;

    ssl_certificate /etc/letsencrypt/live/${ORIGIN_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ORIGIN_CERT_NAME}/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header Referrer-Policy same-origin;

    # Must match the public edge. The application applies the stricter per-file,
    # count and aggregate support-upload limits.
    client_max_body_size 32m;

    location /static/ {
        alias /var/www/static/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        gzip_static on;
        gzip_vary on;
    }

    # Authorization stays in Django; nginx only serves an internal path after
    # Django returns X-Accel-Redirect. Range requests keep video seeking cheap.
    location /_protected_support_media/ {
        internal;
        alias /var/www/media/;
        access_log off;
        add_header X-Content-Type-Options nosniff always;
        add_header Cross-Origin-Resource-Policy same-origin always;
    }

    location / {
        proxy_pass http://monkey_island_app;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
