# ============================================================================
# Monkey Island Website — ПРОДАКШЕН-конфиг origin-сервера (docker/website/.env)
#
# Скопируйте этот файл в docker/website/.env и заполните. Его читают:
#   - docker-compose.yml (окружение контейнера Django);
#   - issue-certs.sh / renew-certs.sh (сертификат origin-nginx, ORIGIN_*);
#   - update-origin-allowlist.sh (allowlist IP edge-прокси);
#   - deploy.sh (проверяет наличие .env перед выкаткой).
# Формат: KEY=value, списки через запятую, если не указано иное.
# ============================================================================

# --- Django-ядро -----------------------------------------------------------
# Длинная случайная строка (секрет сессий/токенов входа/magic-links).
# Смена значения разлогинит всех пользователей.
SECRET_KEY=replace-me
# В проде всегда False.
DEBUG=False

# ВСЕ домены сайта (включая www-варианты!), без схемы, через запятую.
# Сайт получает исходный Host от edge-прокси как есть.
ALLOWED_HOSTS=promo.example.com,neutral.example.com,cabinet.example.com
# Те же домены со схемой https:// — для CSRF-проверки форм.
CSRF_TRUSTED_ORIGINS=https://promo.example.com,https://neutral.example.com,https://cabinet.example.com

# --- Роли доменов (какой лендинг где показывать) ---------------------------
# Роль выбирается по Host входящего запроса; www-домены перечислять явно
# (www автоматически не отбрасывается). Домен без роли получает роль vpn.
# PROMO_DOMAINS (синоним VPN_DOMAINS) — прямая VPN-подача (index_vpn.html).
PROMO_DOMAINS=promo.example.com
# NEUTRAL_DOMAINS (синоним VPS_DOMAINS) — «нейтральные» домены: продаём как
# VPS/личный сервер, слово VPN не звучит (index_vps.html).
NEUTRAL_DOMAINS=neutral.example.com
# Домены личного кабинета: на главной сразу форма входа, онбординг-слайды
# не показываются.
CABINET_DOMAINS=cabinet.example.com
# Канонический URL кабинета — используется в письмах (magic-link, код входа)
# и редиректах, когда запрос пришёл не с cabinet-домена.
DEFAULT_CABINET_DOMAIN=cabinet.example.com

# --- Базы данных (их ДВЕ, не перепутайте!) ---------------------------------
# Служебная БД самого Django (django_*: сессии, встроенная админка).
# Отдельная маленькая база; её мигрирует entrypoint через manage.py migrate.
WEB_DATABASE_URL=postgresql://web_user:replace-me@postgres:5432/web_db
# True — подключение к web-БД строго по SSL (для внешних managed-БД).
WEB_DATABASE_SSL_REQUIRE=False
# ОБЩАЯ продуктовая БД проекта (users, платежи, подписки) — SQLAlchemy.
# Схему ведёт Alembic из common/ (владелец — репозиторий бота),
# Django её НЕ мигрирует.
SERVICE_DATABASE_URL=postgresql://user:password@db-host:5432/service_db

# --- RWMS (gRPC-мост к панели Remnawave) -----------------------------------
# Через него сайт создаёт/читает подписки Remnawave.
RWMS_HOST=rwms-host
RWMS_PORT=50052

# --- Платежи ---------------------------------------------------------------
# Активный шлюз: wata | yookassa. Runtime-переопределяется ключом
# payment_gateway в system_settings (админка).
PAYMENT_GATEWAY=wata
# WATA: базовый URL API и Bearer-токен мерчанта.
WATA_HOST=https://wata.example.com
WATA_TOKEN=replace-me
# YooKassa: магазин и секретный ключ (нужны при PAYMENT_GATEWAY=yookassa
# и для рекуррентных списаний).
YOOKASSA_SHOP_ID=replace-me
YOOKASSA_SECRET_KEY=replace-me

# --- Транзакционная почта сайта (magic-link, коды входа) -------------------
# НЕ путать с отдельным email-сервисом рассылок — здесь только письма,
# которые сайт шлёт сам. Провайдер: smtp | resend.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=login@example.com
EMAIL_HOST_PASSWORD=replace-me
# Resend (используются при EMAIL_PROVIDER=resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Telegram-вход ---------------------------------------------------------
# Username основного бота (без @) — показывается в ссылках t.me/<бот>.
TG_BOT_USERNAME=monkeyislandvpnbot
# Токен виджет-бота по умолчанию (проверка подписи Telegram Login Widget).
TELEGRAM_AUTH_BOT_TOKEN=replace-me
# Пер-доменные боты для Telegram Login Widget: виджет-домен в BotFather
# привязывается только к одному боту, поэтому на каждый домен — свой бот.
# Формат: домен|username_бота|токен_бота, записи через запятую.
TELEGRAM_AUTH_BOTS=promo.example.com|monkeyislandvpnbot|replace-me,cabinet.example.com|monkeyislandcabinetbot|replace-me
# Карта «домен → start-код» для входа через t.me/<бот>?start=webvN.
# Формат: домен|webvN через запятую; коды обязаны совпадать с обратной
# картой MI_VPN_BOT_WEB_LOGIN_URLS в конфиге бота (webvN|https://кабинет).
# Домен без записи шлёт "web" = webv1.
TELEGRAM_WEB_LOGIN_START_CODES=

# --- Админка поддержки (/support-admin/) -----------------------------------
# Пароль роли admin (полный доступ) и роли support (только тикеты).
# Оба пустые = админка отключена.
SUPPORT_ADMIN_PASSWORD=
SUPPORT_STAFF_PASSWORD=

# --- GeoIP для аналитики подключений ---------------------------------------
# DB-IP City Lite скачивается без аккаунта и ключей. Лидер-поток infra_worker
# внутри Django обновляет её в named volume без отдельного контейнера или cron.
GEOIPUPDATE_INTERVAL_HOURS=168
# TTL backend-агрегации стран/регионов.
INFRA_GEOIP_CACHE_SECONDS=60

# --- Origin-nginx: TLS-сертификат и защита от прямого доступа --------------
# Эти четыре переменные использует НЕ Django, а скрипты рядом
# (issue-certs.sh, renew-certs.sh, update-origin-allowlist.sh).
#
# ORIGIN_CERT_NAME — имя-ярлык сертификата у certbot (--cert-name) и имя
# каталога /etc/letsencrypt/live/<имя>/, откуда nginx читает fullchain.pem.
# ОДНО имя без запятых; домены (SAN) задаются следующей переменной.
# На это же имя должен указывать EDGE_ORIGIN_TLS_NAME в конфиге edge.
ORIGIN_CERT_NAME=origin.teaworld.uk
# Список доменов (SAN) сертификата origin-сервера, через запятую.
ORIGIN_CERTBOT_DOMAINS=origin.teaworld.uk
# CIDR-адреса edge-серверов, которым разрешено ходить на origin
# (update-origin-allowlist.sh генерирует allow/deny для nginx);
# прямые запросы мимо edge отклоняются.
ORIGIN_ALLOWED_PROXY_CIDRS=203.0.113.10/32,203.0.113.11/32
# Email для уведомлений Let's Encrypt об истечении сертификатов.
LETSENCRYPT_EMAIL=admin@example.com
