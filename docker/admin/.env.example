SHREDDER_ADMIN_SITE_PORT=8016
SHREDDER_ADMIN_SITE_WORKERS=2
SHREDDER_ADMIN_SITE_THREADS=4
SHREDDER_ADMIN_SITE_TIMEOUT=60
SHREDDER_ADMIN_SITE_DEBUG=false
SHREDDER_ADMIN_SITE_SECRET_KEY=replace-with-a-long-random-secret
SHREDDER_ADMIN_SITE_ALLOWED_HOSTS=admin.example.com,127.0.0.1,localhost
SHREDDER_ADMIN_SITE_CSRF_TRUSTED_ORIGINS=https://admin.example.com,http://127.0.0.1:8016

# Django sessions and internal framework tables. Keep this database separate
# from the shared Shredder product database.
SHREDDER_ADMIN_SITE_WEB_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/shredder_admin_web

# Shared Shredder product database. This service never applies common/Alembic
# migrations automatically.
SHREDDER_ADMIN_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/shredder

SHREDDER_ADMIN_REDIS_URL=
SHREDDER_ADMIN_RWMS_HOST=127.0.0.1
SHREDDER_ADMIN_RWMS_PORT=50051

# Single named administrator. Keep the real password only in the ignored .env.
# Rotating either value invalidates existing administrative sessions.
SHREDDER_ADMIN_SITE_PASSWORD=replace-me
SHREDDER_ADMIN_SITE_USERNAME=admin
SHREDDER_ADMIN_SITE_SUPPORT_PASSWORD=

SHREDDER_ADMIN_YOOKASSA_SHOP_ID=
SHREDDER_ADMIN_YOOKASSA_SECRET=

SHREDDER_ADMIN_BOT_REDIS_HOST=127.0.0.1
SHREDDER_ADMIN_BOT_REDIS_PORT=6379
SHREDDER_ADMIN_BOT_REDIS_PASSWORD=
SHREDDER_ADMIN_BOT_REDIS_QUEUES=shredder-vpn-bot
