server {
    listen 80 default_server;
    server_name ${EDGE_SERVER_NAMES};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${EDGE_SERVER_NAMES};

    ssl_certificate /etc/letsencrypt/live/${EDGE_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${EDGE_CERT_NAME}/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options ${EDGE_FRAME_OPTIONS};
    add_header Referrer-Policy ${EDGE_REFERRER_POLICY};

    client_max_body_size 10m;

    location / {
        proxy_pass ${EDGE_ORIGIN_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";

        proxy_ssl_server_name on;
        proxy_ssl_name ${EDGE_ORIGIN_TLS_NAME};
        proxy_ssl_verify ${EDGE_ORIGIN_TLS_VERIFY};
        # Origin's Let's Encrypt chain is cross-signed several intermediates deep
        # (leaf -> YE1 -> Root YE -> ISRG Root X2 -> ISRG Root X1). nginx defaults
        # proxy_ssl_verify_depth to 1, which can't reach the trusted root and fails
        # with "(20:unable to get local issuer certificate)" -> 502. Allow room.
        proxy_ssl_verify_depth 5;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_buffering ${EDGE_PROXY_BUFFERING};
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
