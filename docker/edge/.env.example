# ============================================================================
# Monkey Island Edge — конфиг фронтового прокси (docker/edge/.env)
#
# Edge — это nginx, который принимает публичный HTTPS-трафик всех доменов
# и проксирует его на один origin-сервер (docker/website). Файл читают:
#   - docker-compose.yml / nginx.conf.template (переменные EDGE_*);
#   - issue-certs.sh / renew-certs.sh (выпуск сертификата через Cloudflare DNS);
#   - deploy.sh (проверка наличия .env).
# ============================================================================

# Домены, которые обслуживает edge, ЧЕРЕЗ ПРОБЕЛ (подставляется в nginx
# server_name как есть). Перечислить все, включая www-варианты.
EDGE_SERVER_NAMES=monkey-island-vpn.com www.monkey-island-vpn.com

# ВНИМАНИЕ: это НЕ Subject/CN сертификата, а имя-ярлык «линейки» у certbot
# (--cert-name) и одновременно имя каталога /etc/letsencrypt/live/<имя>/,
# откуда nginx берёт fullchain.pem/privkey.pem. ОДНО слово, БЕЗ запятых.
# Домены (SAN) сертификата задаются ниже в EDGE_CERTBOT_DOMAINS —
# certbot выпускает ОДИН сертификат сразу на весь их список.
EDGE_CERT_NAME=monkey-island-vpn.com

# Куда проксировать трафик: URL origin-сервера (со схемой). Один upstream
# на все домены; исходный Host сохраняется, роль домена решает Django.
EDGE_ORIGIN_UPSTREAM=https://origin.teaworld.uk

# Имя, которое edge ожидает в TLS-сертификате origin'а (SNI + проверка).
# Должно совпадать с ORIGIN_CERT_NAME/ORIGIN_CERTBOT_DOMAINS на origin-сервере.
EDGE_ORIGIN_TLS_NAME=origin.teaworld.uk

# on — проверять сертификат origin'а (рекомендуется). off — доверять слепо.
EDGE_ORIGIN_TLS_VERIFY=on

# Заголовок X-Frame-Options (защита от clickjacking): SAMEORIGIN | DENY.
EDGE_FRAME_OPTIONS=SAMEORIGIN

# Заголовок Referrer-Policy.
EDGE_REFERRER_POLICY=strict-origin-when-cross-origin

# on — буферизовать ответы origin'а в nginx (обычно on).
EDGE_PROXY_BUFFERING=on

# --- Выпуск сертификата (issue-certs.sh, DNS-01 через Cloudflare) ----------
# Email для уведомлений Let's Encrypt об истечении сертификата.
LETSENCRYPT_EMAIL=admin@example.com

# API-токен Cloudflare с правом Zone -> DNS -> Edit для ВСЕХ зон из
# EDGE_CERTBOT_DOMAINS (валидация домена идёт через DNS-записи).
CF_DNS_API_TOKEN=replace-me

# Домены (SAN) сертификата, ЧЕРЕЗ ЗАПЯТУЮ. Все попадают в один сертификат
# с именем EDGE_CERT_NAME. При изменении списка issue-certs.sh сам
# перевыпустит сертификат. Учтите: полный список SAN публично виден в
# Certificate Transparency-логах — если vps-домены не должны связываться
# с vpn-брендом, выносите их на отдельный edge с отдельным сертификатом.
EDGE_CERTBOT_DOMAINS=monkey-island-vpn.com,www.monkey-island-vpn.com

# Сколько секунд ждать распространения DNS-записи валидации (обычно 30).
CF_DNS_PROPAGATION_SECONDS=30
